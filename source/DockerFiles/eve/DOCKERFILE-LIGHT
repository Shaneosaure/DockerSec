FROM kalilinux/kali-rolling

WORKDIR /root

ENV DEBIAN_FRONTEND=noninteractive
# packages de base nécessaires pour le build / réseau
RUN apt-get update && apt-get -y upgrade && apt-get -y autoremove && apt-get clean && \
    apt-get update && apt-get install -y --no-install-recommends \
      iproute2 inetutils-ping curl host mtr-tiny tcpdump iptables traceroute ssh ca-certificates gnupg dirmngr \
    && rm -rf /var/lib/apt/lists/*

# liste des outils (ajoute/enlève selon besoin)
ENV PACKAGES="aircrack-ng amap apt-utils bsdmainutils cewl crackmapexec crunch dirb dirbuster dnsenum dnsrecon dnsutils \
dos2unix enum4linux exploitdb ftp gcc git gobuster golang hashcat hping3 hydra iputils-ping john joomscan kpcli \
libffi-dev make masscan metasploit-framework mimikatz nasm nbtscan ncat netcat-traditional nikto nmap onesixtyone \
oscanner passing-the-hash patator php powershell proxychains4 python2 python3 python3-pip python3-setuptools \
python3-dev recon-ng responder ruby-dev samba samdump2 seclists sipvicious smbclient smbmap smtp-user-enum snmp socat \
sqlmap ssh-audit sslscan testssl.sh theharvester tnscmd10g vim wafw00f weevely wfuzz whatweb wordlists"

RUN apt-get update && apt-get install -y --no-install-recommends $PACKAGES || (apt-get -f install -y && apt-get install -y --no-install-recommends $PACKAGES) && \
    rm -rf /var/lib/apt/lists/*

# copie conditionnelle du fichier ssh config si présent (robuste)
RUN if [ -f /usr/share/kali-defaults/etc/ssh/ssh_config.d/kali-wide-compat.conf ]; then \
      mkdir -p /etc/ssh/ssh_config.d && \
      cp -f /usr/share/kali-defaults/etc/ssh/ssh_config.d/kali-wide-compat.conf /etc/ssh/ssh_config.d/; \
    fi

# nettoyage final et mise en place d'un user non-root si voulu (optionnel)
RUN apt-get autoclean && apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

CMD ["/bin/bash"]
